# Mode Flags: offline/mock strategy (see Section 9 of PLAN.md)
FIREBASE_MODE=memory         # 'rest' for live Firebase, 'memory' for in-memory mock
ESP32_MODE=mock              # 'wokwi' for real ESP32 in Wokwi, 'mock' for mock_esp32.py
VISION_MODE=replay           # 'live' for real YOLO inference, 'replay' for JSON replays
MONGO_MODE=memory            # 'mongo' for live MongoDB, 'memory' for embedded mock (CI/offline)

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Firebase Realtime Database (used when FIREBASE_MODE=rest)
FIREBASE_DB_URL=https://emergency-traffic-controller-default-rtdb.europe-west1.firebasedatabase.app
FIREBASE_DB_SECRET=

# MongoDB (used when MONGO_MODE=mongo)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=smart_intersection

# Security & Auth (JWT HS256)
JWT_SECRET=dev-jwt-secret-do-not-use-in-production-abcdef123456
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Command Signing (HMAC-SHA256, Section 5.4 P2)
HMAC_SECRET=dev-hmac-shared-key-wokwi-server-2026
HMAC_ENFORCE=false

# Rate Limiting
RATE_LIMIT_DETECTIONS_PER_SEC=10
RATE_LIMIT_BURST=20

# Vision & Training
ROBOFLOW_API_KEY=
